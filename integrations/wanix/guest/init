#!/bin/busybox sh
# The packaged Alpine root already contains BusyBox's applet links. Recreating
# all of them over the external 9P root adds hundreds of serialized metadata
# operations before the shell appears. Retain a fallback for stripped custom
# roots without penalizing the normal comparison image.
if [ ! -x /bin/mount ] || [ ! -x /usr/bin/setsid ]; then
    /bin/busybox --install -s /bin
fi

mount_fs() {
    /bin/busybox mount "$@"
}

mount_fs -t proc none /proc

# rv64.js uses its ns16550 UART for the interactive console; copy/v86 uses
# virtio-console so that ttyS0 remains available to hostexport. Derive the
# terminal from the kernel command line instead of baking either architecture
# into the otherwise shared init.
console=ttyS0
for arg in $(/bin/busybox cat /proc/cmdline 2>/dev/null); do
    case "$arg" in
        console=*)
            console=${arg#console=}
            console=${console%%,*}
            ;;
    esac
done
console_device=/dev/$console
echo "WANIX guest init" >"$console_device"

# tmux and other terminfo consumers refuse to start without a term name.
export TERM=xterm

mount_fs -t sysfs none /sys
/bin/busybox mkdir -p /dev/pts
mount_fs -t devpts devpts /dev/pts

if [ -f /etc/wanix-container ]; then
    echo 1 >/proc/sys/net/ipv4/ip_forward
fi

# The root is the WANIX namespace over 9P, where unix sockets (tmux) and
# fast scratch files have no home. Give /tmp and /run real tmpfs mounts so
# tmux and package managers behave like a normal Linux root.
/bin/busybox mkdir -p /tmp /run /dev/shm
mount_fs -t tmpfs tmpfs /tmp
mount_fs -t tmpfs tmpfs /run
mount_fs -t tmpfs tmpfs /dev/shm

: "${SHELL:=/bin/sh}"
if [ -n "$export" ]; then
    EXPORTDEV=/dev/$export hostexport &
    unset export
fi
if [ -f /boot/rc ]; then
    . /boot/rc
fi

case " $(/bin/busybox cat /proc/cmdline) " in
    *" rv64.benchmark=1 "*)
        # The three-way harness does not use guest networking. Avoid making
        # cold boot wait for the optional fetch proxy's second 9P mount.
        ;;
    *" rv64.network=fetch "*)
        /bin/busybox ifconfig eth0 10.0.2.15 netmask 255.255.255.0 up
        /bin/busybox route add default gw 10.0.2.2
        export http_proxy=http://10.0.2.2:8080
        export HTTP_PROXY="$http_proxy"

        # The fetch backend exposes its public interception CA through a
        # second read-only 9P mount. Convert its DER certificate to PEM with
        # BusyBox's base64 applet, avoiding any dependency on openssl.
        /bin/busybox mkdir -p /run/rv64-proxy
        if mount_fs -t 9p -o trans=virtio,version=9p2000.L rv64-proxy /run/rv64-proxy 2>/dev/null; then
            if [ -f /run/rv64-proxy/ca.der ] && [ -f /etc/ssl/certs/ca-certificates.crt ]; then
                {
                    echo '-----BEGIN CERTIFICATE-----'
                    /bin/busybox base64 /run/rv64-proxy/ca.der
                    echo '-----END CERTIFICATE-----'
                } >>/etc/ssl/certs/ca-certificates.crt
                export https_proxy="$http_proxy"
                export HTTPS_PROXY="$https_proxy"
            fi
        fi
        ;;
esac

echo "WANIX shell ready" >"$console_device"
exec setsid -c "$SHELL" -i <>"$console_device" >&0 2>&1
